# Em certas circunstâncias, é possível encadear uma função na outra, facilita a escrita e a leitura do código

(dados_tempo
.assign(sem_km = round((dados_tempo['semaforos']/dados_tempo['distancia']), 2))
.query('tempo >= 30')
.rename(columns={'periodo':'per'})
.groupby('per')
.agg({'sem_km':'mean',
      'distancia': 'mean',
      'per': 'count'}
    )
)


# Poderia criar um objeto normalmente!

df_ajustes = (dados_tempo
.assign(sem_km = round((dados_tempo['semaforos']/dados_tempo['distancia']), 2))
.query('tempo >= 30')
.rename(columns={'periodo':'per'})).sort_values('estudante').reset_index(drop=True)

