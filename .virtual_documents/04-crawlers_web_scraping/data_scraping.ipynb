from bs4 import BeautifulSoup
import pandas as pd
import requests
import time
todos = []
for livro in s.find_all("article", class_="product_pod"):
    link_relativo = livro.find("h3").find("a")["href"]
    url_livro = f"https://books.toscrape.com/catalogue/{link_relativo}"
    
    r2 = requests.get(url_livro)
    s2 = BeautifulSoup(r2.text, "lxml")
    
    # breadcrumb tem a categoria: Home > Books > Travel > Título
    breadcrumb = s2.find("ul", class_="breadcrumb").find_all("li")
    genero_real = breadcrumb[2].get_text(strip=True)
    
    todos.append({
        "titulo": livro.find("h3").find("a")["title"],
        "preco": livro.find("p", class_="price_color").get_text(strip=True),
        "nota": livro.find("p", class_="star-rating")["class"][1],
        "genero": genero_real,
    })
    time.sleep(1)
todos = pd.DataFrame(todos)
todos


# organizar em tabela e salvar
import pandas as pd

df = pd.DataFrame(todos)
df.to_csv("livros.csv", index=False)
print("Total de livros coletados:", len(df))
