import requests
from bs4 import BeautifulSoup
import pandas as pd
import time

todos = []
n = 1

while True:
    URL = f"https://webscraper.io/test-sites/pagination?page={n}"
    res = requests.get(URL)
    if res.status_code != 200:
        break
    bs = BeautifulSoup(res.text,"lxml")
    carros = bs.find_all("div",class_="card")

    if not carros:
        print (f"Página {n} vazia, parando")
        break
        
    for carro in carros:
        fabricante = carro.find("h3").find("a").get_text(strip=True)
        modelo = carro.find("p",class_="description").get_text(strip=True)
        dados_modelo = carro.find_all("p",class_="card-text")
        ano = dados_modelo[0].get_text(strip=True)
        #ano = ano.replace("Year:","").strip()
        origem = dados_modelo[1].get_text(strip = True)
        #origem = origem.replace("Country of origin:","").strip()
        milhagem = dados_modelo[2].get_text(strip=True)
        #milhagem = milhagem.replace("Mileage:","").strip()
        todos.append({"fabricante":fabricante,"modelo":modelo,"ano":ano,"origem":origem,"milhagem":milhagem})
        time.sleep(1)
    n = n + 1
todos = pd.DataFrame(todos)
todos


todos['origem'].value_counts(ascending=False)






